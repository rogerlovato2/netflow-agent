# Compiled binaries
bin/

# The SQLite database is the whole state of an install, and it holds the
# server's and the clients' private keys. It must never reach a repository.
*.db
*.db-wal
*.db-shm

# Local configuration for a real install: the file that carries the endpoint,
# the interface names and the admin password.
docker/.env

# rtk's cache
.rtk/

# macOS
.DS_Store
._*

# The window's build output: the bundle, and the frontend it embeds.
desktop/build/bin/
desktop/frontend/dist/
desktop/frontend/node_modules/
# Generated from the Go side on every build, and wrong the moment it is stale.
desktop/frontend/wailsjs/
